[Unit]
Description=Jaga Padi backend (FastAPI + SPA, HTTPS :8000)
Requires=rikub-db.service
After=rikub-db.service
PartOf=rikub.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=/home/pi/rikub-project/server
Environment=MPLCONFIGDIR=/home/pi/rikub-project/.cache/matplotlib
# Cert must cover the current LAN IP before uvicorn loads it.
ExecStartPre=/home/pi/rikub-project/ensure-cert.sh
ExecStart=/home/pi/rikub-project/server/venv/bin/uvicorn main:app \
  --host 0.0.0.0 --port 8000 \
  --ssl-keyfile /home/pi/rikub-project/certs/key.pem \
  --ssl-certfile /home/pi/rikub-project/certs/cert.pem
# Only report "active" once /health answers ok (DB reachable) - rikub-cv and the
# launcher key off this, so nothing heavy overlaps the backend's own startup.
ExecStartPost=/home/pi/rikub-project/deploy/wait-healthy.sh 120
TimeoutStartSec=180
Restart=on-failure
RestartSec=5

[Install]
WantedBy=rikub.target
