DATABASE_URL=postgresql+psycopg://postgres:password@127.0.0.1:5433/jaga_padi

# soerogis drone gRPC backend address (mission control, telemetry). Bare
# host:port, no scheme. Used by server/app/grpc_backend.py.
BACKEND_GRPC_ADDR=localhost:50051

# Comma-separated allowed CORS origins (scheme://host:port). Optional — defaults to the
# LAN, Tailscale, and loopback URLs in server/app/security.py. Override this (no code
# change) if the Pi's LAN IP changes. Example:
# CORS_ALLOWED_ORIGINS=https://10.68.184.10:8000,https://100.64.85.33:8000
